import Floor.Moves
import Mathlib.Tactic.Group
import Mathlib.GroupTheory.FreeGroup.Reduce

/-!
# Floor.Bounded — bounded-conjugate subgroups and the route lemma (★)

`H R k` is the subgroup generated by all conjugates `u * r * u⁻¹` of the two relators of `R`
by words `u` of length at most `k`. Length is measured on letter lists (`Short k`); this is the
reduced length (`short_iff_norm_le`), but the list form avoids any reduced-word bookkeeping.

* `H_apply_nonconj`: codes 0–5 do not change `H R k` (the generating sets differ by inverses
  and by products with a conjugate of the other relator by the same `u`).
* `H_apply_conj`: a code in 6–13 conjugates by one letter `g`, and `u (g r g⁻¹) u⁻¹ = (u g) r (u g)⁻¹`.
* `route_mem` (★): along a route to (x, y) with `c` conjugation moves, `x, y ∈ H R c`.
  No minimum over radii is ever taken.
-/

namespace Floor

/-- Words of letter length at most `k`. -/
def Short (k : ℕ) : Set F2 := {u | ∃ L : List Letter, L.length ≤ k ∧ FreeGroup.mk L = u}

/-- The generating conjugates of radius `k`. -/
def gens (R : Pair) (k : ℕ) : Set F2 :=
  {w | ∃ u ∈ Short k, w = u * R.1 * u⁻¹ ∨ w = u * R.2 * u⁻¹}

/-- The bounded-conjugate subgroup `H R k = ⟨u r u⁻¹ : |u| ≤ k, r ∈ R⟩`. -/
def H (R : Pair) (k : ℕ) : Subgroup F2 := Subgroup.closure (gens R k)

/-! ### Short words -/

theorem one_short (k : ℕ) : (1 : F2) ∈ Short k := ⟨[], by simp, rfl⟩

theorem short_mono {k k' : ℕ} (h : k ≤ k') : Short k ⊆ Short k' := by
  rintro u ⟨L, hL, rfl⟩
  exact ⟨L, hL.trans h, rfl⟩

theorem short_inv {k : ℕ} {u : F2} (hu : u ∈ Short k) : u⁻¹ ∈ Short k := by
  obtain ⟨L, hL, rfl⟩ := hu
  exact ⟨FreeGroup.invRev L, by rwa [FreeGroup.invRev_length], FreeGroup.inv_mk.symm⟩

theorem short_mul_letter {k : ℕ} {u : F2} (hu : u ∈ Short k) (l : Letter) :
    u * FreeGroup.mk [l] ∈ Short (k + 1) := by
  obtain ⟨L, hL, rfl⟩ := hu
  exact ⟨L ++ [l], by simp; omega, FreeGroup.mul_mk.symm⟩

theorem gx_eq : gx = FreeGroup.mk [((0 : Fin 2), true)] := rfl

theorem gy_eq : gy = FreeGroup.mk [((1 : Fin 2), true)] := rfl

theorem gx_inv_eq : gx⁻¹ = FreeGroup.mk [((0 : Fin 2), false)] := by
  rw [gx_eq, FreeGroup.inv_mk]; rfl

theorem gy_inv_eq : gy⁻¹ = FreeGroup.mk [((1 : Fin 2), false)] := by
  rw [gy_eq, FreeGroup.inv_mk]; rfl

/-- `Short k` is exactly the ball of reduced length `k` (Mathlib's `FreeGroup.norm`). -/
theorem short_iff_norm_le (k : ℕ) (u : F2) : u ∈ Short k ↔ u.norm ≤ k := by
  constructor
  · rintro ⟨L, hL, rfl⟩
    exact FreeGroup.norm_mk_le.trans hL
  · intro h
    exact ⟨u.toWord, h, FreeGroup.mk_toWord⟩

/-! ### Membership and monotonicity -/

theorem conj_fst_mem {R : Pair} {k : ℕ} {u : F2} (hu : u ∈ Short k) :
    u * R.1 * u⁻¹ ∈ H R k :=
  Subgroup.subset_closure ⟨u, hu, Or.inl rfl⟩

theorem conj_snd_mem {R : Pair} {k : ℕ} {u : F2} (hu : u ∈ Short k) :
    u * R.2 * u⁻¹ ∈ H R k :=
  Subgroup.subset_closure ⟨u, hu, Or.inr rfl⟩

/-- To bound `H S k`, it suffices to place its generating conjugates. -/
theorem H_le_of {S R : Pair} {k k' : ℕ}
    (h1 : ∀ u ∈ Short k, u * S.1 * u⁻¹ ∈ H R k')
    (h2 : ∀ u ∈ Short k, u * S.2 * u⁻¹ ∈ H R k') : H S k ≤ H R k' := by
  rw [H, Subgroup.closure_le]
  rintro w ⟨u, hu, rfl | rfl⟩
  · exact h1 u hu
  · exact h2 u hu

theorem H_mono (R : Pair) {k k' : ℕ} (h : k ≤ k') : H R k ≤ H R k' :=
  H_le_of (fun _ hu => conj_fst_mem (short_mono h hu))
    (fun _ hu => conj_snd_mem (short_mono h hu))

/-! ### Codes 0–5 preserve `H R k` -/

theorem conj_mul (u a b : F2) : u * (a * b) * u⁻¹ = (u * a * u⁻¹) * (u * b * u⁻¹) := by group

theorem conj_inv (u a : F2) : u * a⁻¹ * u⁻¹ = (u * a * u⁻¹)⁻¹ := by group

/-- One inclusion for each non-conjugation code. -/
theorem H_apply_nonconj_le (m : Move) (hm : m.code < 6) (R : Pair) (k : ℕ) :
    H (apply m R) k ≤ H R k := by
  cases m <;> simp only [Move.code] at hm <;> try omega
  all_goals refine H_le_of (fun u hu => ?_) (fun u hu => ?_) <;>
    simp only [apply, conj_mul, conj_inv] <;>
    first
    | exact conj_fst_mem hu
    | exact conj_snd_mem hu
    | exact inv_mem (conj_fst_mem hu)
    | exact inv_mem (conj_snd_mem hu)
    | exact mul_mem (conj_fst_mem hu) (conj_snd_mem hu)
    | exact mul_mem (conj_fst_mem hu) (inv_mem (conj_snd_mem hu))
    | exact mul_mem (conj_snd_mem hu) (conj_fst_mem hu)
    | exact mul_mem (conj_snd_mem hu) (inv_mem (conj_fst_mem hu))

/-- The reverse inclusion: the old relators are recovered from the new ones with the same `u`. -/
theorem H_apply_nonconj_ge (m : Move) (hm : m.code < 6) (R : Pair) (k : ℕ) :
    H R k ≤ H (apply m R) k := by
  cases m <;> simp only [Move.code] at hm <;> try omega
  · refine H_le_of (fun u hu => ?_) (fun u hu => conj_snd_mem (R := apply .c0 R) hu)
    simpa [apply, conj_inv] using inv_mem (conj_fst_mem (R := apply .c0 R) hu)
  · refine H_le_of (fun u hu => conj_fst_mem (R := apply .c1 R) hu) (fun u hu => ?_)
    simpa [apply, conj_inv] using inv_mem (conj_snd_mem (R := apply .c1 R) hu)
  · refine H_le_of (fun u hu => ?_) (fun u hu => conj_snd_mem (R := apply .c2 R) hu)
    have e : u * R.1 * u⁻¹ = (u * (R.1 * R.2) * u⁻¹) * (u * R.2 * u⁻¹)⁻¹ := by group
    rw [e]
    exact mul_mem (conj_fst_mem (R := apply .c2 R) hu)
      (inv_mem (conj_snd_mem (R := apply .c2 R) hu))
  · refine H_le_of (fun u hu => ?_) (fun u hu => conj_snd_mem (R := apply .c3 R) hu)
    have e : u * R.1 * u⁻¹ = (u * (R.1 * R.2⁻¹) * u⁻¹) * (u * R.2 * u⁻¹) := by group
    rw [e]
    exact mul_mem (conj_fst_mem (R := apply .c3 R) hu) (conj_snd_mem (R := apply .c3 R) hu)
  · refine H_le_of (fun u hu => conj_fst_mem (R := apply .c4 R) hu) (fun u hu => ?_)
    have e : u * R.2 * u⁻¹ = (u * (R.2 * R.1) * u⁻¹) * (u * R.1 * u⁻¹)⁻¹ := by group
    rw [e]
    exact mul_mem (conj_snd_mem (R := apply .c4 R) hu)
      (inv_mem (conj_fst_mem (R := apply .c4 R) hu))
  · refine H_le_of (fun u hu => conj_fst_mem (R := apply .c5 R) hu) (fun u hu => ?_)
    have e : u * R.2 * u⁻¹ = (u * (R.2 * R.1⁻¹) * u⁻¹) * (u * R.1 * u⁻¹) := by group
    rw [e]
    exact mul_mem (conj_snd_mem (R := apply .c5 R) hu) (conj_fst_mem (R := apply .c5 R) hu)

/-- **L3.** Codes 0–5 leave every bounded-conjugate subgroup unchanged. -/
theorem H_apply_nonconj (m : Move) (hm : m.code < 6) (R : Pair) (k : ℕ) :
    H (apply m R) k = H R k :=
  le_antisymm (H_apply_nonconj_le m hm R k) (H_apply_nonconj_ge m hm R k)

/-! ### Codes 6–13 cost at most one unit of radius -/

theorem conj_letter (u g r : F2) : u * (g * r * g⁻¹) * u⁻¹ = (u * g) * r * (u * g)⁻¹ := by group

theorem conj_letter' (u g r : F2) : u * (g⁻¹ * r * g) * u⁻¹ = (u * g⁻¹) * r * (u * g⁻¹)⁻¹ := by
  group

theorem conj_short_fst {R : Pair} {k : ℕ} {u : F2} (hu : u ∈ Short k) (l : Letter) :
    (u * FreeGroup.mk [l]) * R.1 * (u * FreeGroup.mk [l])⁻¹ ∈ H R (k + 1) :=
  conj_fst_mem (short_mul_letter hu l)

theorem conj_short_snd {R : Pair} {k : ℕ} {u : F2} (hu : u ∈ Short k) (l : Letter) :
    (u * FreeGroup.mk [l]) * R.2 * (u * FreeGroup.mk [l])⁻¹ ∈ H R (k + 1) :=
  conj_snd_mem (short_mul_letter hu l)

/-- **L4.** A conjugation code raises the needed radius by at most one. -/
theorem H_apply_conj (m : Move) (hm : 6 ≤ m.code) (R : Pair) (k : ℕ) :
    H (apply m R) k ≤ H R (k + 1) := by
  have s : ∀ {u : F2}, u ∈ Short k → u ∈ Short (k + 1) := fun hu => short_mono (by omega) hu
  cases m <;> simp only [Move.code] at hm <;> try omega
  · refine H_le_of (fun u hu => ?_) (fun u hu => conj_snd_mem (s hu))
    show u * (gx * R.1 * gx⁻¹) * u⁻¹ ∈ _
    rw [conj_letter, gx_eq]; exact conj_short_fst hu _
  · refine H_le_of (fun u hu => ?_) (fun u hu => conj_snd_mem (s hu))
    show u * (gx⁻¹ * R.1 * gx) * u⁻¹ ∈ _
    rw [conj_letter', gx_inv_eq]; exact conj_short_fst hu _
  · refine H_le_of (fun u hu => ?_) (fun u hu => conj_snd_mem (s hu))
    show u * (gy * R.1 * gy⁻¹) * u⁻¹ ∈ _
    rw [conj_letter, gy_eq]; exact conj_short_fst hu _
  · refine H_le_of (fun u hu => ?_) (fun u hu => conj_snd_mem (s hu))
    show u * (gy⁻¹ * R.1 * gy) * u⁻¹ ∈ _
    rw [conj_letter', gy_inv_eq]; exact conj_short_fst hu _
  · refine H_le_of (fun u hu => conj_fst_mem (s hu)) (fun u hu => ?_)
    show u * (gx * R.2 * gx⁻¹) * u⁻¹ ∈ _
    rw [conj_letter, gx_eq]; exact conj_short_snd hu _
  · refine H_le_of (fun u hu => conj_fst_mem (s hu)) (fun u hu => ?_)
    show u * (gx⁻¹ * R.2 * gx) * u⁻¹ ∈ _
    rw [conj_letter', gx_inv_eq]; exact conj_short_snd hu _
  · refine H_le_of (fun u hu => conj_fst_mem (s hu)) (fun u hu => ?_)
    show u * (gy * R.2 * gy⁻¹) * u⁻¹ ∈ _
    rw [conj_letter, gy_eq]; exact conj_short_snd hu _
  · refine H_le_of (fun u hu => conj_fst_mem (s hu)) (fun u hu => ?_)
    show u * (gy⁻¹ * R.2 * gy) * u⁻¹ ∈ _
    rw [conj_letter', gy_inv_eq]; exact conj_short_snd hu _

/-! ### The standard pair and the route lemma -/

theorem gx_mem_H_standard : gx ∈ H standard 0 := by
  simpa [standard] using conj_fst_mem (R := standard) (one_short 0)

theorem gy_mem_H_standard : gy ∈ H standard 0 := by
  simpa [standard] using conj_snd_mem (R := standard) (one_short 0)

/-- **L5, endpoint.** The standard pair generates the free group at radius zero. -/
theorem H_standard_zero : H standard 0 = ⊤ := by
  rw [eq_top_iff, ← FreeGroup.closure_range_of, Subgroup.closure_le]
  rintro w ⟨i, rfl⟩
  fin_cases i
  · exact gx_mem_H_standard
  · exact gy_mem_H_standard

/-- One move transports the bounded-conjugate subgroups backwards. -/
theorem H_apply_le (m : Move) (R : Pair) (c : ℕ) :
    H (apply m R) c ≤ H R (c + if m.IsConj then 1 else 0) := by
  by_cases h : m.IsConj
  · simpa [h] using H_apply_conj m h R c
  · simp only [h, if_false, Nat.add_zero]
    exact (H_apply_nonconj m (by simp only [Move.IsConj] at h; omega) R c).le

/-- **(★) Route lemma.** If `ms` takes `R` to (x, y), then x and y lie in `H R (conjCount ms)`. -/
theorem route_mem (ms : List Move) (R : Pair) (h : applyList ms R = standard) :
    gx ∈ H R (conjCount ms) ∧ gy ∈ H R (conjCount ms) := by
  induction ms generalizing R with
  | nil =>
    simp only [applyList_nil] at h
    subst h
    exact ⟨gx_mem_H_standard, gy_mem_H_standard⟩
  | cons m ms ih =>
    have hle := H_apply_le m R (conjCount ms)
    have hc : conjCount (m :: ms) = conjCount ms + if m.IsConj then 1 else 0 := by
      unfold conjCount
      by_cases hm : m.IsConj <;> simp [hm]
    obtain ⟨h1, h2⟩ := ih (apply m R) h
    rw [hc]
    exact ⟨hle h1, hle h2⟩

end Floor
